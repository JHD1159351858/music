# Local persistence is ready without cloud credentials (tested with Node.js 22.21.1).
ZHIYIN_STORAGE_MODE=local
# Optional durable directory; defaults to ./data. Back up this entire directory.
ZHIYIN_DATA_DIR=
# Temporary local student testing without login; disable to restore SSO.
ZHIYIN_STUDENT_TEST_MODE=false

# Chaoxing SSO broker: see docs/chaoxing-auth.md. Secrets are server-only.
CHAOXING_SSO_BASE_URL=https://sdtqvk3ybm.coze.site
CHAOXING_SSO_SHARED_SECRET=
ZHIYIN_TEACHER_SECURITY_PASSWORD=123456
# Optional >=32-character secret. Defaults to persistent data/.auth-secret.
ZHIYIN_SESSION_SECRET=
# Optional canonical public origin behind HTTPS reverse proxies. Omit locally;
# when set, use the exact external origin (no path/query), never an empty value.
# ZHIYIN_PUBLIC_ORIGIN=https://piano.example.edu.cn

# Optional remote mode: set ZHIYIN_STORAGE_MODE=supabase and supply these values.
CODER_SUPABASE_URL=
# Server-only service_role / secret key. Anonymous or publishable keys are not accepted.
CODER_SUPABASE_SERVICE_ROLE_KEY=
CODER_SUPABASE_TENANT_ID=

# PostgreSQL connection for applying Drizzle migrations, not browser code.
DATABASE_URL=

# coder-coding-dev-sdk platform and object storage.
CODER_CODING_API_KEY=
CODER_CODING_BASE_URL=

# Model service. May use a separate credential and endpoint from object storage.
CODER_CODING_MODEL_API_KEY=
CODER_CODING_MODEL_BASE_URL=
